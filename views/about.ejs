    <div class="col-md-6">
      <div class="row g-3 text-center">
        <div class="col-6"><div class="stat"><strong>3</strong><span>Servicios</span></div></div>
        <div class="col-6"><div class="stat"><strong>4</strong><span>Páginas</span></div></div>
        <div class="col-6"><div class="stat"><strong>100%</strong><span>Responsive</span></div></div>
        <div class="col-6"><div class="stat"><strong>24/7</strong><span>En la nube</span></div></div>
      </div>
    </div>
